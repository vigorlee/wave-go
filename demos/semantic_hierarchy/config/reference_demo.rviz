Panels: []
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz/PointCloud2
    Name: Model semantic points
    Enabled: false
    Topic: /reference_map/model_semantic_points
    Queue Size: 1
    Style: Points
    Size (Pixels): 2
    Color Transformer: RGB8
    Position Transformer: XYZ
    Alpha: 1.0
    Decay Time: 0
  - Class: rviz/PointCloud2
    Name: Model unknown context
    Enabled: false
    Topic: /reference_map/model_context
    Queue Size: 1
    Style: Points
    Size (Pixels): 1
    Color Transformer: RGB8
    Position Transformer: XYZ
    Alpha: 0.32
    Decay Time: 0
  - Class: rviz/MarkerArray
    Name: Model object outlines
    Enabled: false
    Marker Topic: /reference_map/model_boxes
    Queue Size: 1
  - Class: rviz/MarkerArray
    Name: Model object labels
    Enabled: false
    Marker Topic: /reference_map/model_labels
    Queue Size: 1
  - Class: rviz/PointCloud2
    Name: Height cloud
    Enabled: true
    Topic: /reference_map/height_points
    Queue Size: 1
    Style: Points
    Size (Pixels): 1
    Color Transformer: RGB8
    Position Transformer: XYZ
    Alpha: 1.0
    Decay Time: 0
  - Class: rviz/PointCloud2
    Name: Height cutaway
    Enabled: false
    Topic: /reference_map/height_cutaway
    Queue Size: 1
    Style: Points
    Size (Pixels): 1
    Color Transformer: RGB8
    Position Transformer: XYZ
    Alpha: 1.0
    Decay Time: 0
  - Class: rviz/PointCloud2
    Name: Semantic cloud
    Enabled: false
    Topic: /reference_map/semantic_points
    Queue Size: 1
    Style: Points
    Size (Pixels): 1
    Color Transformer: RGB8
    Position Transformer: XYZ
    Alpha: 0.5
    Decay Time: 0
  - Class: rviz/MarkerArray
    Name: Instance cuboids
    Enabled: true
    Marker Topic: /reference_map/instances
    Queue Size: 1
  - Class: rviz/MarkerArray
    Name: Instance labels
    Enabled: true
    Marker Topic: /reference_map/labels
    Queue Size: 1
  - Class: rviz/MarkerArray
    Name: Recorded LIO trajectory
    Enabled: true
    Marker Topic: /reference_map/trajectory
    Queue Size: 1
  Global Options:
    Fixed Frame: lio_map
    Background Color: 250; 251; 253
    Frame Rate: 20
  Enabled: true
  Name: root
  Tools:
  - Class: rviz/Interact
  - Class: rviz/MoveCamera
  - Class: rviz/Select
  - Class: rviz/FocusCamera
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 35
      Pitch: 0.67
      Yaw: 0.65
      Target Frame: lio_map
      Focal Point:
        X: 9
        Y: 3
        Z: 2
      Near Clip Distance: 0.01
      Focal Shape Size: 0.02
